{
  "name": "@zackdk/dsh-weixin",
  "version": "0.1.2",
  "description": "DeepSeek Harness ↔ 微信通道插件，基于腾讯官方 iLink Bot 接口",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeByZack/dsh-weixin.git"
  },
  "author": "zackdk",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "weixin",
    "wechat",
    "chatbot"
  ],
  "main": "./plugin-src/host/channels/weixin/index.mjs",
  "exports": {
    ".": "./plugin-src/host/channels/weixin/index.mjs",
    "./plugin": "./plugin-src/host/channels/weixin/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/",
    "plugin-src/",
    "lib/",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "verify:imports": "node scripts/verify-imports.mjs",
    "build:client": "node plugin-src/client/build.mjs",
    "verify:tarball": "mkdir -p .audit && npm pack --silent | tail -n 1 > .audit/tarball.txt && tar -xzf $(cat .audit/tarball.txt) -C .audit && node scripts/audit-tarball.mjs .audit/package $(cat .audit/tarball.txt)",
    "prepublishOnly": "npm run verify:imports && npm run verify:tarball"
  },
  "publishConfig": {
    "access": "public"
  }
}
